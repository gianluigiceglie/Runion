{
  "name": "runion-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Runion design system foundations (tokens from Figma) and prototype components",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "preview": "python3 -m http.server 4310",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "storybook": "10.6.5",
    "typescript": "5.6.3",
    "vite": "6.4.6"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
  }
}
